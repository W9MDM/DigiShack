# --- DigiShack environment ---
#
# Copy to .env. `./scripts/install.sh` does this for you and generates
# SETTINGS_KEY automatically.
#
# ONLY these three values belong here. Everything else — QRZ, LoTW, eQSL,
# ClubLog, HRDLOG, SMTP, PSKReporter, the bridge — is configured in the
# web UI under Settings, and stored encrypted in the database.
#
# Why these three can't move:
#   DATABASE_URL  settings live IN the database, so its credentials can't
#   SETTINGS_KEY  the key that decrypts those settings can't itself be encrypted
#   PORT          needed before the app can query anything

# ============================================================
# Required
# ============================================================

DATABASE_URL="mysql://digishack:changeme@127.0.0.1:3306/digishack"

# Master key for encrypted settings. Generate with:
#   openssl rand -hex 32
#
# WARNING: changing or losing this makes every stored credential permanently
# undecryptable. Back it up with your database, and never regenerate it on an
# existing install. install.sh will not overwrite an existing value.
SETTINGS_KEY=""

# Port the Next.js app listens on, behind NGINX.
PORT=3000

# ============================================================
# Legacy fallbacks — optional
# ============================================================
#
# Settings read from the database first, then from these variables, then from a
# built-in default. They exist so an install that predates the Settings UI keeps
# working after upgrading.
#
# You do not need to set any of them. Saving a value in the UI takes precedence,
# and the Settings page marks anything still coming from here so you can see
# what's left to move. Once a setting shows as stored in the database, delete its
# variable below — leaving a plaintext credential on disk is the thing the
# Settings UI exists to avoid.

# APP_BASE_URL="http://localhost:3000"
# SESSION_TTL_DAYS=30
# REDIS_URL="redis://127.0.0.1:6379"

# QRZ_USERNAME=""
# QRZ_PASSWORD=""
# QRZ_LOGBOOK_API_KEY=""

# LOTW_USERNAME=""
# LOTW_PASSWORD=""
# LoTW uploads need a callsign certificate, not a program. Upload the .p12 from TQSL under
# Settings > Logbook of the World; it is stored encrypted under SETTINGS_KEY. There is no
# environment variable for it, because a private key does not belong in a shell profile.

# EQSL_USERNAME=""
# EQSL_PASSWORD=""

# CLUBLOG_EMAIL=""
# CLUBLOG_PASSWORD=""
# CLUBLOG_API_KEY=""

# HRDLOG_CALLSIGN=""
# HRDLOG_CODE=""

# PSKREPORTER_CONTACT=""

# WSJTX_UDP_PORT=2237
# WSJTX_UDP_HOST="0.0.0.0"
# BRIDGE_PORT=3101
# BRIDGE_TOKEN=""

# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="DigiShack <noreply@example.com>"
